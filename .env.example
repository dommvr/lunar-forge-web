# Public Supabase project values. The publishable key is designed for browser use;
# authorization still depends on Supabase policies and server-side verification.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Browser-facing FastAPI origin. Do not put backend secrets in this value.
NEXT_PUBLIC_LUNAR_FORGE_API_URL=http://127.0.0.1:8080

# Temporary server-controlled role/suspension lists for this frontend-only phase.
# Use Supabase Auth user UUIDs, separated by commas. These values are never public.
LUNAR_FORGE_ADMIN_USER_IDS=00000000-0000-0000-0000-000000000000
LUNAR_FORGE_SUSPENDED_USER_IDS=

# Read-only sibling checkout used by the documentation sync command.
LUNAR_FORGE_CORE_PATH=C:/Users/you/path/to/lunar-forge

# Intentionally absent: a Supabase secret/service-role key. Do not add one to
# NEXT_PUBLIC_* variables or use one in this Next.js authentication phase.
# NEXT_PUBLIC_LUNAR_FORGE_API_E2E_MODE is test-only and is set by Playwright.
