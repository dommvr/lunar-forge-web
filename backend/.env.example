LUNAR_FORGE_WEB_ENVIRONMENT=local
LUNAR_FORGE_WEB_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LUNAR_FORGE_WEB_SUPABASE_ISSUER=https://your-project.supabase.co/auth/v1
LUNAR_FORGE_WEB_SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
LUNAR_FORGE_WEB_SUPABASE_AUDIENCE=authenticated
LUNAR_FORGE_WEB_DATABASE_URL=sqlite+aiosqlite:///./lunar-forge-web.db
LUNAR_FORGE_WEB_WORKER_SHARED_SECRET=replace-with-a-long-random-secret
# Test-only deterministic bearer tokens. This setting is rejected in production.
LUNAR_FORGE_WEB_FAKE_AUTH_ENABLED=false

# Production must use HTTPS origins, an asymmetric Supabase JWKS endpoint,
# postgresql+asyncpg, and a non-placeholder worker secret of at least 32 chars.
