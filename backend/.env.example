LUNAR_FORGE_WEB_ENVIRONMENT=local
LUNAR_FORGE_WEB_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LUNAR_FORGE_WEB_SUPABASE_ISSUER=https://your-project.supabase.co/auth/v1
LUNAR_FORGE_WEB_SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
LUNAR_FORGE_WEB_SUPABASE_AUDIENCE=authenticated
LUNAR_FORGE_WEB_DATABASE_URL=sqlite+aiosqlite:///./lunar-forge-web.db
LUNAR_FORGE_WEB_WORKER_SHARED_SECRET=replace-with-a-long-random-secret
LUNAR_FORGE_WEB_SERVICE_ROLE=api
LUNAR_FORGE_WEB_TURN_EXECUTION_BACKEND=fake
LUNAR_FORGE_WEB_WORKER_URL=
LUNAR_FORGE_WEB_WORKER_AUDIENCE=
# API-to-worker client timeout; deliberately longer than the worker's
# 960-second Cloud Run request timeout.
LUNAR_FORGE_WEB_WORKER_REQUEST_TIMEOUT_SECONDS=975
LUNAR_FORGE_WEB_WEBSOCKET_HEARTBEAT_SECONDS=15
LUNAR_FORGE_WEB_RUNTIME_BACKEND=e2b
LUNAR_FORGE_WEB_E2B_API_KEY=e2b_replace_me
LUNAR_FORGE_WEB_E2B_PYTHON_CLI_TEMPLATE=lfw-python-cli-v1
LUNAR_FORGE_WEB_E2B_STATIC_SITE_TEMPLATE=lfw-static-site-v1
LUNAR_FORGE_WEB_E2B_VITE_REACT_TEMPLATE=lfw-vite-react-v1
# Configure this only on the private worker through Secret Manager. Never set
# it on the public API service and never put it in an E2B environment.
# LUNAR_FORGE_WEB_OWNER_FUNDED_API_KEY=
LUNAR_FORGE_WEB_OWNER_FUNDED_MODEL=openai/gpt-5-mini
LUNAR_FORGE_WEB_OWNER_FUNDED_INPUT_COST_MICROUSD_PER_MILLION=0
LUNAR_FORGE_WEB_OWNER_FUNDED_OUTPUT_COST_MICROUSD_PER_MILLION=0
LUNAR_FORGE_WEB_BYOK_OPENAI_MODEL=openai/gpt-5-mini
LUNAR_FORGE_WEB_BYOK_ANTHROPIC_MODEL=anthropic/claude-sonnet-4-5
# Test-only deterministic bearer tokens. This setting is rejected in production.
LUNAR_FORGE_WEB_FAKE_AUTH_ENABLED=false

# Production must use HTTPS origins, an asymmetric Supabase JWKS endpoint,
# postgresql+asyncpg, and a non-placeholder worker secret of at least 32 chars.
# Set service role `worker` on the private worker and `private_worker` as the
# turn backend on the public API.
